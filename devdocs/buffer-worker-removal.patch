-const schema = [
-  { name: 'id', type: 'INTEGER' },
-  { name: 'context', type: 'TEXT' },
-  { name: 'signalk_timestamp', type: 'TEXT' },
-  { name: 'value_latitude', type: 'REAL' },
-  { name: 'exported', type: 'INTEGER' },
